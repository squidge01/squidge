---
import "../styles/global.css"
import WavyButton from "../components/WavyButton.jsx"
const {title = "Vito Torres"} = Astro.props;
---

<html lang = "en">
    <head>
        <meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    </head>
    <body>
        <nav class = "navBar">
            <WavyButton href = "/" client:load>Home</WavyButton>
            <WavyButton href = "/images" client:load>Images</WavyButton>
            <WavyButton href = "/404" client:load>Videos</WavyButton>
            <WavyButton href = "/404" client:load>Projects</WavyButton>
        </nav>
        <slot />
        <footer>
            <div style = {{display : "flex", gap : "5vw", justifyContent : "center", paddingBottom : "2rem", paddingTop : "3rem"}}>
                <a href = "https://www.linkedin.com/in/vito-torres-410099351/">LinkedIn</a>
                <a href = "https://www.youtube.com/@squidge_01/videos">Youtube</a>
                <a href = "https://github.com/squidge01">Github</a>
            </div>
        </footer>
    </body>
</html>